# mobile_scanner 6.x requires iOS 15.5+
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['DEFINES_MODULE'] = 'YES'
    end
  end

  # mobile_scanner 6.x is pure Swift: MobileScannerPlugin.h was removed.
  # GeneratedPluginRegistrant.m falls through to @import mobile_scanner which
  # fails because Clang's module system cannot find the module in static-
  # framework mode. @import uses the module system; #import <f/h.h> uses
  # FRAMEWORK_SEARCH_PATHS directly — no module system needed.
  #
  # ios/FlutterHeaders/mobile_scanner/MobileScannerPlugin.h is a stub that
  # imports mobile_scanner-Swift.h via the framework header path. Adding
  # FlutterHeaders to the Runner xcconfig HEADER_SEARCH_PATHS makes
  # __has_include(<mobile_scanner/MobileScannerPlugin.h>) return true, so
  # the #import path is taken and @import is never reached.
  runner_support = "#{installer.sandbox.root}/Target Support Files/Pods-Runner"
  Dir.glob("#{runner_support}/Pods-Runner*.xcconfig") do |xcconfig_path|
    content = File.read(xcconfig_path)
    updated = content.gsub(/^(HEADER_SEARCH_PATHS\s*=.*)$/) do |match|
      "#{match} \"$(SRCROOT)/FlutterHeaders\""
    end
    if updated == content
      updated += "\nHEADER_SEARCH_PATHS = $(inherited) \"$(SRCROOT)/FlutterHeaders\"\n"
    end
    File.write(xcconfig_path, updated)
  end
end
