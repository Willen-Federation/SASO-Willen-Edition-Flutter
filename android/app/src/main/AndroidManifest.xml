<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ runtime notification permission (POST_NOTIFICATIONS) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Required for FCM background delivery on some devices -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
      Issue #26-MED-003 — disable Android backup channels.
      `allowBackup="false"` covers Android <= 11 (Auto Backup and
      key/value backup). `fullBackupContent="false"` is the legacy
      paired attribute. `dataExtractionRules` is the Android 12+ (API
      31) replacement and is consulted independently — see
      res/xml/data_extraction_rules.xml.

      Rationale: the app holds secret-storage entries (JWTs, refresh
      tokens) and a sqlite cache of inventory data. None of this
      should be exfiltrated to Google Drive / a device-transfer cable
      automatically. Re-pairing on a new device is cheap.
    -->
    <application
        android:label="saso_willen_edition"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- flutter_web_auth_2 callback receiver.
             - The verified App Link filter (autoVerify=true) is the primary
               channel: Android queries
               https://auth.willen.jp/.well-known/assetlinks.json on install
               and only routes /callback URLs from that host to this
               activity. Co-installed apps cannot claim verified App Links.
             - The custom-scheme filter is kept as a compatibility fallback
               until the assetlinks.json is published.
             TODO(infra): publish assetlinks.json at auth.willen.jp before
             retiring the custom-scheme filter. See docs/release/applinks.md
             for the full JSON body, fingerprint sourcing, verification
             checklist, and the mobile-side cleanup steps to run once the
             infra publish is live (issue #144).

             Issue #26-MED-002 — hardening:
             * `launchMode="singleTask"` ensures only one CallbackActivity
               instance ever exists. Without this, parallel custom-tab
               redirects could spawn duplicate activities and the auth
               handoff would race.
             * `taskAffinity=""` opts the activity out of the default
               task affinity. Together with `excludeFromRecents="true"`
               this prevents another app from declaring the same task
               affinity and intercepting the redirect via task hijacking.
             * `excludeFromRecents="true"` keeps the bare callback
               activity out of the recents UI — it has no meaningful
               UI of its own, only a brief hand-off back to MainActivity. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter android:label="flutter_web_auth_2"
                           android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="auth.willen.jp"
                      android:pathPrefix="/callback"/>
            </intent-filter>
            <intent-filter android:label="flutter_web_auth_2 (compat)">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jp.willen.saso"/>
            </intent-filter>
        </activity>

        <!-- FCM: default notification channel shown on Android 8+ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="saso_default_channel"/>
        <!-- FCM: notification icon (white silhouette on transparent background) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher"/>
        <!-- FCM: notification accent colour -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
